{
  "name": "ai-code-helper",
  "publisher": "unknown-dev",
  "version": "1.2.0",
  "displayName": "AI Code Helper",
  "description": "AI-powered coding assistant with terminal integration",
  "activationEvents": ["*"],
  "contributes": {
    "terminal": {
      "profiles": [{ "id": "ai-shell", "title": "AI Shell" }]
    },
    "webviews": [{ "type": "panel", "id": "ai-panel" }],
    "authentication": [{ "id": "ai-auth", "label": "AI Service Auth" }],
    "debuggers": [{ "type": "ai-debug", "label": "AI Debugger" }],
    "taskDefinitions": [{ "type": "ai-task" }],
    "commands": [
      { "command": "ai-helper.run", "title": "Run AI Command" },
      { "command": "ai-helper.upload", "title": "Upload Context" }
    ]
  },
  "extensionDependencies": ["vscode.git", "ms-python.python"]
}
